#!/bin/bash
set -euo pipefail

# Path to target config file
config_file="/var/www/html/config.php"

# Check if config.php already exists
if [ -f "$config_file" ]; then
    echo "✅ config.php already exists. Skipping generation."
    exit 0
fi

echo "🔧 Generating Moodle config.php..."

php -d max_input_vars=10000 /var/www/html/admin/cli/install.php \
    --lang="${MOODLE_LANGUAGE:-en}" \
    --wwwroot="${SITE_URL}" \
    --dataroot="/var/www/moodledata/" \
    --dbtype="${DB_TYPE}" \
    --dbhost="${DB_HOST}" \
    --dbname="${DB_NAME}" \
    --dbuser="${DB_USER}" \
    --dbpass="${DB_PASS}" \
    --dbport="${DB_PORT:-3306}" \
    --prefix="${DB_PREFIX:-mdl_}" \
    --fullname="${MOODLE_SITENAME}" \
    --shortname="moodle" \
    --adminuser="${MOODLE_USERNAME}" \
    --adminpass="${MOODLE_PASSWORD}" \
    --adminemail="${MOODLE_EMAIL}" \
    --non-interactive \
    --agree-license \
    --skip-database \
    --allow-unstable

echo "✅ config.php has been created."
